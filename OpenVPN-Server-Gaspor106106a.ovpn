client
dev tun
proto tcp
remote gaspor.ddns.net 1194
resolv-retry infinite
nobind

# Downgrade privileges after initialization (non-Windows only)
user nobody
group nogroup

persist-key
persist-tun

auth-user-pass
remote-cert-tls server
cipher AES-256-CBC
verb 3

auth SHA1
key-direction 1

reneg-sec 0

redirect-gateway def1

